# Keys are read from your shell environment; put them here only if they are not exported already.
#   OPENAI_API_KEY   the local demo's model (OpenAI). Amazon Bedrock is used on AgentCore (Demo 02).
#   TAVILY_API_KEY   (or TAVILY_KEY) https://app.tavily.com/home

# ── Neo4j AuraDB ─────────────────────────────────────────────────────────────
# Fill in from the credentials file Aura downloads when you create the instance. Leave nothing here you would not commit:
# .env is git-ignored, this file is not.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── Local Neo4j (../scripts/setup_local_neo4j.sh prints these) ───────────────
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=
# NEO4J_DATABASE=
